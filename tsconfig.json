{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "seanime/types/**/*.ts",
    "seanime/compatibility/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "seanime/templates/**"
  ]
}
