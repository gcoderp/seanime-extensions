{
  "name": "cloudstream-seanime-converter",
  "version": "2.6.0",
  "private": true,
  "description": "Automated Cloudstream (.cs3) to Seanime TypeScript/Goja JavaScript Extension Converter & Marketplace Generator",
  "scripts": {
    "discover": "python3 scripts/discover.py",
    "convert": "python3 scripts/convert.py",
    "convert:fixtures": "python3 scripts/convert.py --fixtures",
    "typecheck": "node scripts/typecheck.mjs",
    "validate": "node scripts/validate.mjs && python3 scripts/check_schema.py",
    "publish": "python3 scripts/publish.py",
    "fixtures:build": "python3 tests/fixtures/build_fixtures.py",
    "test": "python3 -m pytest tests/ -v",
    "reindex": "python3 scripts/reindex.py",
    "republish": "python3 scripts/reindex.py"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
