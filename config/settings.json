{
  "github_owner": "gcoderp",
  "github_repo": "seanime-extensions",
  "github_branch": "main",
  "converter_version": "2.6.0",
  "security": {
    "max_zip_entries": 2500,
    "max_uncompressed_bytes": 52428800,
    "max_compression_ratio": 80.0,
    "block_private_ips": true,
    "allowed_schemes": [
      "https"
    ]
  },
  "publish_gates": {
    "require_js_parse": true,
    "require_known_license": true,
    "require_recovered_selectors": true,
    "require_live_test": false,
    "reject_placeholder_hosts": true
  },
  "ai_fallback": {
    "enabled_if_secret_present": false,
    "provider": "openai_compatible",
    "model": "gpt-4o-mini",
    "max_tokens": 4096,
    "strict_goja_validation": true,
    "note": "Not implemented. Reserved for a future strategy 4; must be opt-in and validated like any other strategy."
  },
  "licensing": {
    "require_known_license": true,
    "allowed_spdx": [
      "MIT",
      "GPL-3.0",
      "GPL-3.0-only",
      "GPL-3.0-or-later",
      "Apache-2.0",
      "BSD-3-Clause",
      "Unlicense",
      "TEST_FIXTURE"
    ],
    "redact_secrets_patterns": [
      "(?i)(api[_-]?key|secret|token|authorization)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{16,}['\"]"
    ],
    "unknown_license_policy": "publish_with_notice"
  }
}
